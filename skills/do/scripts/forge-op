# Forge operation dispatcher. Translates named forge operations into the
# appropriate forge-CLI commands (gh for GitHub, bkt for Bitbucket when #10
# lands). Consumers call this instead of raw `gh` / `bkt` commands — the
# mirror of vcs-op one layer up (vcs-op abstracts git/jj; forge-op abstracts
# the remote host API).
#
# Three surfaces:
#
#   forge-op detect              → prints the detected forge name
#                                  (github/bitbucket/unknown). The sole
#                                  classifier; sync calls this instead of
#                                  carrying its own URL→forge case.
#
#   forge-op supports <op>       → exit 0 if the detected forge supports
#                                  <op>, exit 1 if not. Reads an internal
#                                  capability table. sync calls this to
#                                  pre-compute supportsX booleans into
#                                  .do-results.json for the ops nodes
#                                  actually branch on.
#
#   forge-op <op> [args]          → dispatch the operation. Body-bearing ops
#                                  (pr-create, pr-edit, pr-comment) take
#                                  --body-file <path|->; "-" reads from stdin
#                                  and pipes straight to `gh --body-file -`
#                                  (gh supports stdin via --body-file -),
#                                  so no tempfile is needed.
#
# Detection: reads $forge from .do-results.json (written by sync via
# `forge-op detect`). If absent, falls back to classifying the origin URL
# via vcs-op remote-url — the same classifier, so out-of-workflow callers
# (ralph loading forge-pr without sync) get consistent results.
#
# Usage:
#   forge-op detect
#   forge-op supports <op>
#   forge-op pr-view
#   forge-op pr-create [--draft] --head <branch> --base <branch> --title "<t>" [--body-file <path|->]
#   forge-op pr-edit [--title "<t>"] [--body-file <path|->]
#   forge-op pr-comment [--body-file <path|->]
#   forge-op issue-view <url>
#   forge-op pr-checks
#
# Operations:
#   detect         → print the forge name (the sole classifier)
#   supports <op>  → capability query (exit 0/1)
#   pr-view        → prints PR info for the current branch (or exits non-zero if none)
#   pr-create      → create a (draft) PR
#   pr-edit        → edit title and/or body of the current branch's PR
#   pr-comment     → post a comment on the current branch's PR
#   issue-view     → print an issue's body (GitHub only — BB Server has no issues)
#   pr-checks      → print CI check status for the current branch's PR
#
# Capability table (the single source of "which forge supports which op"):
#   github:    all ops ✓
#   bitbucket: all ✗ until #10 lands (no dispatch arm — the default
#              "unsupported forge" catch handles it)
#   unknown:   all ✗
#
# When #10 lands: add bitbucket dispatch arms + flip the table entry for
# bitbucket. sync, workflow.ncl, nodes, forge-pr — none change.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/state.sh"

# The full op vocabulary. Listed once here; `supports`, `dispatch`, and the
# usage/error messages all derive from it so adding an op is one edit.
OPS="pr-view pr-create pr-edit pr-comment issue-view pr-checks"

# Classify an origin URL into a forge name. The sole classifier — sync calls
# `forge-op detect` rather than carrying its own copy of this glob set, so
# adding a forge (e.g. gitlab) is one edit here, not two.
classify_url() {
  case "$1" in
    *github.com*)  echo github ;;
    *bitbucket.*)  echo bitbucket ;;
    *)             echo unknown ;;
  esac
}

# Resolve forge from state, with a URL-classification fallback. sync is the
# canonical writer (via `forge-op detect`); the fallback covers direct
# invocation outside the workflow (e.g. ralph loading forge-pr without sync).
detect_forge() {
  if [ -n "${FORGE_OVERRIDE:-}" ]; then
    echo "$FORGE_OVERRIDE"
    return
  fi
  local f
  f="$(state_get forge)"
  if [ -n "$f" ]; then
    echo "$f"
    return
  fi
  local url
  url="$(bash "$SCRIPT_DIR/vcs-op" remote-url 2>/dev/null || echo "")"
  classify_url "$url"
}

# Capability table. Returns 0 (supported) or 1 (not).
# Arg: operation name.
supports() {
  local op="${1:?op required}"
  local forge
  forge="$(detect_forge)"
  case "$forge" in
    github)
      # Every op in the vocabulary is supported on github today.
      for known in $OPS; do
        [ "$op" = "$known" ] && return 0
      done
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

forge="$(detect_forge)"

# Dispatch on github. bitbucket/unknown fall through to the default
# "unsupported forge" error in the main case — no stub arm (a stub would be
# a false receptacle advertising capability it doesn't have; the workflow
# predicate reading supportsX is the sole gate).
dispatch_github() {
  local op="$1"; shift
  case "$op" in
    pr-view)      gh pr view "$@" ;;
    pr-create)    gh pr create "$@" ;;
    pr-edit)      gh pr edit "$@" ;;
    pr-comment)   gh pr comment "$@" ;;
    issue-view)   gh issue view "$@" ;;
    pr-checks)    gh pr checks "$@" ;;
    *)
      echo "forge-op: unknown operation '$op'" >&2
      echo "Available: detect, supports, $OPS" >&2
      exit 1
      ;;
  esac
}

# ── Main dispatch ──────────────────────────────────────────────────────────

op="${1:-}"
shift || true

case "$op" in
  detect)
    echo "$forge"
    ;;
  supports)
    subop="${1:?op required (e.g. forge-op supports pr-create)}"
    if supports "$subop"; then exit 0; else exit 1; fi
    ;;
  pr-view|pr-create|pr-edit|pr-comment|issue-view|pr-checks)
    case "$forge" in
      github) dispatch_github "$op" "$@" ;;
      *)
        echo "forge-op: forge '$forge' does not support '$op'" >&2
        echo "        Bitbucket support is tracked in srid/agency#10." >&2
        exit 1
        ;;
    esac
    ;;
  "")
    echo "forge-op: no operation given" >&2
    echo "Usage: forge-op <detect|supports|op> [args]" >&2
    echo "Ops: $OPS" >&2
    exit 1
    ;;
  *)
    echo "forge-op: unknown operation '$op'" >&2
    echo "Available: detect, supports, $OPS" >&2
    exit 1
    ;;
esac