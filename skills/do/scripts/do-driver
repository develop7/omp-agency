# /do workflow's driver — a thin state wrapper around do-results.
#
# Does NOT sequence, skip, or retry. The agent reads execution.md for
# choreography and calls this script only to record state and emit summaries.
#
# Usage:
#   do-driver init [--review] [--no-vcs] [--minimal] [--from=<step>] <task>
#     (--base / --stack go to `scripts/steps/sync`, not here)
#   do-driver start <step>
#   do-driver end <status> <verification> [reason]
#     (the step name comes from the active pendingStep, set by `start`;
#     `end` is the only do-driver command that doesn't take a step arg
#     because the caller already used `start` to begin the step)
#   do-driver skip <step> <reason>
#   do-driver set <field> <value>
#   do-driver summary

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DO_RESULTS="$SCRIPT_DIR/do-results"

if [ $# -lt 1 ]; then
  echo "Usage: do-driver <init|start|end|skip|set|summary> ..." >&2
  exit 1
fi

cmd="${1}"
shift

case "$cmd" in
  init)
    review="false"
    noVcs="false"
    minimal="false"
    from=""
    task=""

    while [ $# -gt 0 ]; do
      case "$1" in
        --review) review="true"; shift ;;
        --no-vcs) noVcs="true"; shift ;;
        --minimal) minimal="true"; shift ;;
        --from=*)
          from="${1#*=}"
          shift
          ;;
        # --base / --stack are NOT handled here: they select the stacked-PR
        # base, which sync resolves and persists. do-driver only owns flags
        # that feed the Nickel skip predicates (review/noVcs/minimal/from).
        # Routing --base/--stack here too would echo them (looking authoritative)
        # while sync re-derived base from its own args — a misroute would then
        # silently target master. Reject loudly so the agent routes them to sync.
        --base|--stack)
          echo "do-driver: $1 is a sync flag, not an init flag." >&2
          echo "         pass it to 'bash scripts/steps/sync', not to 'do-driver init'." >&2
          exit 2
          ;;
        --*)
          echo "do-driver: unknown flag: $1" >&2
          exit 2
          ;;
        *)
          task="$1"
          shift
          ;;
      esac
    done

    # --review pauses after research for plan-approval. Any --from that
    # starts past research (followup, post-implement, polish, ci-only)
    # skips the pause entirely — combining the two flags would silently
    # drop the review the user asked for. Force the user to pick one.
    if [ "$review" = "true" ] && [ -n "$from" ] && [ "$from" != "default" ]; then
      echo "do-driver: --review is incompatible with --from=$from" >&2
      echo "         --from=$from starts past research, where the plan-approval pause lives." >&2
      echo "         drop --review if the plan is already approved, or drop --from for a full workflow." >&2
      exit 2
    fi

    bash "$DO_RESULTS" init >/dev/null
    bash "$DO_RESULTS" set review "$review" >/dev/null
    bash "$DO_RESULTS" set noVcs "$noVcs" >/dev/null
    bash "$DO_RESULTS" set minimal "$minimal" >/dev/null
    # Pre-populate vcs at init time. `sync` is the canonical source and
    # will overwrite on its run, but followup entry points skip sync —
    # without this, vcs stays unset in .do-results.json until the agent
    # notices and runs `do-results set vcs <x>` manually.
    vcs="$(bash "$SCRIPT_DIR/vcs-op" detect 2>/dev/null || echo unknown)"
    if [ "$vcs" != "unknown" ]; then
      bash "$DO_RESULTS" set vcs "$vcs" >/dev/null
    fi
    if [ -n "$from" ]; then
      bash "$DO_RESULTS" set from "$from" >/dev/null
    fi
    if [ -n "$task" ]; then
      bash "$DO_RESULTS" set task "$task" >/dev/null
    fi
    echo "init: review=$review noVcs=$noVcs minimal=$minimal from=${from:-default} vcs=${vcs}"
    ;;

  start)
    step="${1:?step required}"
    bash "$DO_RESULTS" step-start "$step"
    ;;

  end)
    status="${1:?status required}"
    verif="${2:-}"
    reason="${3:-}"
    if [ -n "$reason" ]; then
      bash "$DO_RESULTS" step-end "$status" "$verif" "$reason"
    else
      bash "$DO_RESULTS" step-end "$status" "$verif"
    fi
    ;;

  skip)
    step="${1:?step required}"
    reason="${2:?reason required}"
    bash "$DO_RESULTS" step-start "$step"
    bash "$DO_RESULTS" step-end skipped "" "$reason"
    ;;

  set)
    field="${1:?field required}"
    value="${2:?value required}"
    bash "$DO_RESULTS" set "$field" "$value"
    ;;

  summary)
    bash "$SCRIPT_DIR/steps/done"
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    echo "Usage: do-driver <init|start|end|skip|set|summary> ..." >&2
    exit 1
    ;;
esac
