# Semantic VCS operation dispatcher. Translates named operations into
# the appropriate tool-specific commands for git or jj. Consumers call
# this instead of raw `git` or `jj` commands.
#
# Detection: reads $vcs from .do-results.json (written by sync). If that
# file is absent, falls back to filesystem detection (`.jj/` → jj, else
# `.git/` → git, else unknown).
#
# Usage:
#   vcs-op <operation> [args...]
#
# Operations:
#   detect            → prints "git", "jj", or "unknown"
#   fetch             → fetch from remote
#   remote-url        → prints origin URL
#   head-revision     → prints current change/branch identifier
#   head-commit-sha   → prints current commit SHA (for CI verification)
#   default-branch    → prints origin HEAD ref name (the base-resolution input)
#   current-branch    → prints the branch/bookmark the working copy is on
#   base              → prints the resolved base for this run (from state)
#   dirty             → exit 0 if working copy has uncommitted changes, 1 if clean
#   diff-range        → diff between base and current (for review tools)
#   diff-names        → diff-range, name-only
#   diff-stat         → diff-range, summary/stat only
#   new-files         → names of files newly added in current range
#   log-range         → one-line log between base and current
#   log-head          → one-line log of current revision
#   branch <name>       → create a feature branch from the resolved base
#   commit <msg> <f>... → commit/describe the given files (git: explicit
#                         staging; jj: describe @, split unrelated files
#                         into a separate revision, rebase it above @,
#                         move bookmark to @, jj new <bookmark>)
#   push                → push to remote (first push)
#   fix-commit <msg> <f>... → same as commit, then push

set -euo pipefail

# State-reading helpers (jq resolution + state_get) are shared with forge-op
# and any other do/ script that reads .do-results.json. Sourcing lib/state.sh
# gives one resolution path; previously vcs-op inlined this and forge-op would
# have been a second copy.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/state.sh"

# Resolve VCS type
detect_vcs() {
  if [ -n "${VCS_OVERRIDE:-}" ]; then
    echo "$VCS_OVERRIDE"
    return
  fi
  local v
  v="$(state_get vcs)"
  if [ -n "$v" ]; then
    echo "$v"
    return
  fi
  # Filesystem fallback
  if [ -d .jj ]; then echo jj; return; fi
  if [ -d .git ]; then echo git; return; fi
  echo unknown
}

get_default_branch() {
  case "$vcs" in
    git)
      git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || echo master
      ;;
    jj)
      # Name-only template (same idiom as the other bookmark-list sites) so the
      # colon from the default `name: <hash> <desc>` format can't leak —
      # `master:` broke every downstream revset and git-style ref. Fall back to
      # `master` when no main/master remote bookmark exists (matches the
      # pre-base behavior and the bats tests).
      local default
      default=$(jj bookmark list --remote origin -T 'name ++ "\n"' 2>/dev/null | grep -m1 -E '^main|^master' || true)
      if [ -n "$default" ]; then
        echo "$default"
      else
        echo master
      fi
      ;;
    *) echo master ;;
  esac
}

# The resolved base for this /do run: the branch to branch from, diff
# against, and target the PR at. Written by `scripts/steps/sync` after
# resolving --base / --stack / default. Distinct from `get_default_branch`
# (which is the origin-HEAD *input* to that resolution, queried via the
# `default-branch` op).
#
# Reads `base` from `.do-results.json`. No fallback: if `base` is absent
# the workflow never resolved it (e.g. a `--from` entry that skipped sync
# on a fresh run with no prior state), and silently degrading to the
# default branch would flip a stacked run's diffs and PR target to master.
# Error loudly so the caller surfaces it instead of reviewing the wrong diff.
get_base_branch() {
  local base
  base="$(state_get base)"
  if [ -z "$base" ]; then
    echo "vcs-op: base is not set. sync must run first to resolve the base" >&2
    echo "        (from --base <branch>, --stack, or the default branch)." >&2
    echo "        If this was a --from re-run, the parent run did not persist base." >&2
    echo "        (Same error fires if jq is unavailable or .do-results.json is corrupt — check 'command -v jq'.)" >&2
    exit 1
  fi
  echo "$base"
}

# For jj: resolve the range source revision for the diff family
# (diff-range, diff-names, diff-stat, new-files). Returns the merge-base
# of @ and <base> when one exists, otherwise <base> itself. Centralized
# so all four operations share one resolution path — a single revset
# change updates every consumer (#4 hickey finding F1).
#
# Usage: jj_range_from <base>
jj_range_from() {
  local base="${1:?base required}"
  local merge_base
  merge_base=$(jj log -r 'heads(ancestors(@) & ancestors('"$base"'))' --no-graph -T 'change_id' 2>/dev/null | head -1)
  if [ -n "$merge_base" ]; then
    echo "$merge_base"
  else
    echo "$base"
  fi
}

# For jj: after `vcs-op commit` or `vcs-op fix-commit` (both of which
# do `jj describe && jj new`), @ is the new empty change. The
# working bookmark is somewhere up the parent chain (@-, @--,
# @---, ...). Find it (up to 20 levels) and move it to @- so the
# subsequent `vcs-op push` lands on the just-described change.
# Used by both `commit` and `fix-commit`; only meaningful for jj.
#
# Implementation note: the walk starts at `@` (not `@-`). The first
# iteration's `rev="${rev}-"` makes the first query `@-`. So:
#   - default case (bookmark already on @-): found at iter 1, move
#     is a no-op, helper exits. Cheap.
#   - followup case (bookmark on @--, @---, ...): not found at @-,
#     walk continues until found or depth exhausted.
#   - multi-bookmark case (X on @-, Y on @---): X found first, move
#     is a no-op, Y stays put. Matches the original pre-refactor
#     behavior of the `commit` case which had an `if [ -z ... ]`
#     guard on @-.
move_bookmark_to_described_change() {
  local rev="@"
  local bookmark=""
  for _ in $(seq 1 20); do
    rev="${rev}-"
    bookmark="$(jj bookmark list -r "$rev" -T 'name ++ "\n"' 2>/dev/null | head -1)"
    [ -n "$bookmark" ] && break
  done
  if [ -n "$bookmark" ]; then
    jj bookmark move "$bookmark" --to @- || true
  fi
}

# For jj: shared `describe + new + bookmark-move` sequence used by
# both `commit` and `fix-commit`. The caller passes a conventional
# commit message; the function handles the rest.
describe_and_move_bookmark() {
  local msg="${1:?commit message required}"
  jj describe -m "$msg" && jj new
  move_bookmark_to_described_change
}

# For jj: after `jj split && jj rebase -r @- -A @`, @ is still the
# described feature commit (not a new empty change — no `jj new` yet).
# The working bookmark is somewhere up the parent chain (@-, @--, ...).
# Find it and move it to @ (the feature commit), then return its name
# so the caller can pass it to `jj new <bookmark>`.
#
# Unlike move_bookmark_to_described_change (which targets @-), this
# targets @ directly — the split flow keeps the described change as @,
# not @-.
#
# Echoes the bookmark name on stdout (empty if none found).
move_bookmark_to_working_change() {
  local rev="@-"
  local bookmark=""
  for _ in $(seq 1 20); do
    bookmark="$(jj bookmark list -r "$rev" -T 'name ++ "\n"' 2>/dev/null | head -1)"
    [ -n "$bookmark" ] && break
    rev="${rev}-"
  done
  if [ -n "$bookmark" ]; then
    jj bookmark move "$bookmark" --to @ || true
    echo "$bookmark"
  fi
}

# Validate that every file in the given list is dirty (has uncommitted
# changes). Errors and exits if any file is clean or absent — a wrong
# file list means the caller's mental model is off.
#
# Usage: validate_dirty_files <vcs> <file>...
validate_dirty_files() {
  local vcs="$1"; shift
  local bad=()
  for f in "$@"; do
    case "$vcs" in
      git)
        if [ -z "$(git status --porcelain -- "$f" 2>/dev/null)" ]; then
          bad+=("$f")
        fi
        ;;
      jj)
        if [ -z "$(jj diff --name-only -- "$f" 2>/dev/null)" ]; then
          bad+=("$f")
        fi
        ;;
    esac
  done
  if [ "${#bad[@]}" -gt 0 ]; then
    echo "vcs-op: file(s) not dirty (not in working-copy changes): ${bad[*]}" >&2
    echo "        The caller must pass files it actually changed." >&2
    exit 1
  fi
}

# Shared commit logic for both `commit` and `fix-commit`. Files are
# mandatory — at least one file must be passed. The caller passes the
# files that belong to this commit; unrelated working-copy changes are
# staged-only (git) or split into a separate revision above the feature
# commit (jj).
#
# Usage: commit_with_files <vcs> <msg> <file>...
commit_with_files() {
  local vcs="$1" msg="$2"; shift 2
  local files=("$@")
  if [ "${#files[@]}" -eq 0 ]; then
    echo "vcs-op: at least one file required (got none — pass the files you changed)" >&2
    exit 1
  fi
  validate_dirty_files "$vcs" "${files[@]}"
  case "$vcs" in
    git)
      git add -- "${files[@]}"
      git commit -m "$msg"
      ;;
    jj)
      local all_changed to_split=()
      all_changed="$(jj diff --name-only 2>/dev/null)"
      # Canonicalize caller's files to jj-normal form (repo-root-relative,
      # no ./ prefix) so the subtraction comparison isn't defeated by
      # path-format variation (#13). validate_dirty_files already passed,
      # so each file is dirty and resolves to exactly one canonical path.
      local canonical_files=() c f
      for f in "${files[@]}"; do
        while IFS= read -r c; do
          [ -n "$c" ] && canonical_files+=("$c")
        done < <(jj diff --name-only -- "$f" 2>/dev/null)
      done
      # Set subtraction: to_split = all_changed - canonical_files
      local found
      while IFS= read -r changed; do
        [ -z "$changed" ] && continue
        found=false
        for f in "${canonical_files[@]}"; do
          if [ "$changed" = "$f" ]; then
            found=true
            break
          fi
        done
        $found || to_split+=("$changed")
      done <<<"$all_changed"
      if [ "${#to_split[@]}" -gt 0 ]; then
        # Split flow: describe @ as feature, split unrelated files out,
        # rebase the unrelated revision above @, move bookmark to @,
        # then jj new <bookmark> to create a fresh @ on top of feature.
        jj describe -m "$msg"
        jj split "${to_split[@]}" -m "chore: unrelated changes"
        jj rebase -r @- -A @
        local bookmark
        bookmark="$(move_bookmark_to_working_change)"
        if [ -n "$bookmark" ]; then
          jj new "$bookmark"
        else
          jj new
        fi
      else
        # No unrelated files — degenerate to current behavior.
        describe_and_move_bookmark "$msg"
      fi
      ;;
    *) echo "vcs-op: no VCS detected" >&2; exit 1 ;;
  esac
}

vcs="$(detect_vcs)"
op="${1:-}"
shift || true

case "$op" in
  detect)
    echo "$vcs"
    ;;
  fetch)
    case "$vcs" in
      git) git fetch origin ;;
      jj)  jj git fetch ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  remote-url)
    case "$vcs" in
      git) git remote get-url origin ;;
      jj)  jj git remote list | head -1 | awk '{print $2}' ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  head-revision)
    case "$vcs" in
      git) git rev-parse --abbrev-ref HEAD ;;
      jj)
        # Uses @ (not @-) intentionally: the `branch` op creates a
        # bookmark on @ immediately, and this op returns the bookmark
        # tracking @. See `head-commit-sha` for the converse rationale.
        bookmark=$(jj bookmark list -r @ -T 'name ++ "\n"' 2>/dev/null | head -1)
        if [ -z "$bookmark" ]; then
          jj log -r @ --no-graph -T 'change_id' 2>/dev/null
        else
          echo "$bookmark"
        fi
        ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  head-commit-sha)
    # For jj, return the SHA of the just-committed change (@-) — the
    # same axis as log-head. The verify (ci step) compares this against
    # the commit CI ran against, which is the just-pushed commit. Using
    # @ here would return the SHA of the new empty change. (Note:
    # `head-revision` above correctly uses @ instead — it returns the
    # bookmark tracking @, which the `branch` step needs immediately
    # after `jj new && jj bookmark create name -r @`.)
    case "$vcs" in
      git) git rev-parse HEAD ;;
      jj)  jj log -r @- --no-graph -T 'commit_id' 2>/dev/null ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  default-branch)
    get_default_branch
    ;;
  current-branch)
    # The branch/bookmark the working copy is "on" — used by --stack to pick
    # the closest feature branch as the base. git: the checked-out branch
    # ("HEAD" when detached). jj: the bookmark on @, else on @- (the parent
    # of the working change), else "" (nothing to stack onto).
    case "$vcs" in
      git) git rev-parse --abbrev-ref HEAD ;;
      jj)
        b="$(jj bookmark list -r @ -T 'name ++ "\n"' 2>/dev/null | head -1)"
        if [ -z "$b" ]; then
          b="$(jj bookmark list -r @- -T 'name ++ "\n"' 2>/dev/null | head -1)"
        fi
        echo "$b"
        ;;
      *) echo "" ;;
    esac
    ;;
  base)
    get_base_branch
    ;;
  dirty)
    case "$vcs" in
      git) [ -n "$(git status --porcelain)" ] ;;
      jj)  [ -n "$(jj diff -r @ --summary 2>/dev/null)" ] ;;
      *)   false ;;
    esac
    ;;
  diff-range)
    base=$(get_base_branch)
    case "$vcs" in
      git)
        # Three-dot diff: changes since branching from origin/<base>
        git diff "origin/${base}...HEAD" -- "$@"
        ;;
      jj)
        # Diff from merge-base to the working copy (@). @ is the correct
        # target in both states: under --no-vcs the work lives in @ (the
        # commit node is skipped), and after the commit flow @ is a fresh
        # empty change whose tree matches @- so base→@ == base→@-.
        # Previously --to @- missed working-copy-only changes (#4).
        jj diff --from "$(jj_range_from "$base")" --to @ -- "$@"
        ;;
      *) echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  diff-names)
    base=$(get_base_branch)
    case "$vcs" in
      git) git diff "origin/${base}...HEAD" --name-only -- "$@" ;;
      jj)
        jj diff --from "$(jj_range_from "$base")" --to @ --name-only -- "$@"
        ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  diff-stat)
    base=$(get_base_branch)
    case "$vcs" in
      git) git diff "origin/${base}...HEAD" --shortstat -- "$@" ;;
      jj)
        jj diff --from "$(jj_range_from "$base")" --to @ --summary -- "$@"
        ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  new-files)
    base=$(get_base_branch)
    case "$vcs" in
      git) git diff --diff-filter=A --name-only "origin/${base}...HEAD" -- "$@" ;;
      jj)
        # Files added between merge-base and the working copy (@).
        from=$(jj_range_from "$base")
        comm -13 <(jj file list -r "$from" | sort) <(jj file list -r @ | sort)
        ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  log-range)
    base=$(get_base_branch)
    case "$vcs" in
      git) git log "origin/${base}..HEAD" --oneline -- "$@" ;;
      jj)  # Target @ when the working copy holds changes (the --no-vcs
           # state where the commit node was skipped), else @- (post-commit,
           # where @ is a fresh empty change and @- is the described feature).
           # Using @ unconditionally would emit a spurious empty entry (#4).
           # Capture the probe so a jj failure exits loudly instead of
           # silently selecting @- (hickey F2).
           if ! summary=$(jj diff -r @ --summary 2>/dev/null); then
             echo "vcs-op: unable to inspect jj working copy for log-range" >&2
             exit 1
           fi
           if [ -n "$summary" ]; then
             target=@
           else
             target=@-
           fi
           jj log -r "${base}..${target}" --no-graph -T 'separate(" ", commit_id.shortest(8), change_id.shortest(8), description.first_line()) ++ "\n"' 2>/dev/null ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  log-head)
    # For jj, return the just-described change (@-) rather than @.
    # After `vcs-op commit` (which does `jj describe && jj new`), @ is
    # the new empty change; @- is the one the caller just created with
    # the conventional message and that the subsequent `vcs-op push`
    # just pushed. This matches git's `git log -1 --oneline` (return
    # HEAD = the most recent meaningful commit on the branch).
    case "$vcs" in
      git) git log -1 --oneline ;;
      jj)  jj log -r @- --no-graph -n 1 -T 'separate(" ", commit_id.shortest(8), change_id.shortest(8), description.first_line()) ++ "\n"' 2>/dev/null ;;
      *)   echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  branch)
    name="${1:?branch name required}"
    base=$(get_base_branch)
    case "$vcs" in
      git)
        # Hard-error if the parent isn't on the remote: a silent local-ref
        # fallback would make the branch parent and the PR target diverge
        # (reviewers see origin/<base>, the branch was cut from local <base>).
        if ! git rev-parse --verify "refs/remotes/origin/$base" >/dev/null 2>&1; then
          echo "vcs-op branch: origin/$base not found. Push the parent branch before stacking." >&2
          exit 1
        fi
        git branch "$name" "origin/$base"
        ;;
      jj)
        jj new "$base" && jj bookmark create "$name" -r @
        ;;
      *) echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  commit)
    msg="${1:?commit message required}"
    shift
    commit_with_files "$vcs" "$msg" "$@"
    ;;
  push)
    ref="${1:-}"
    case "$vcs" in
      git)
        if [ -n "$ref" ]; then
          git push -u origin "$ref"
        else
          git push
        fi
        ;;
      jj)
        if [ -n "$ref" ]; then
          jj git push --bookmark "$ref"
        else
          jj git push
        fi
        ;;
      *) echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  fix-commit)
    msg="${1:?commit message required}"
    shift
    commit_with_files "$vcs" "$msg" "$@"
    case "$vcs" in
      git) git push ;;
      jj)  jj git push ;;
      *) echo "vcs-op: no VCS detected" >&2; exit 1 ;;
    esac
    ;;
  *)
    echo "vcs-op: unknown operation '$op'" >&2
    echo "Available: detect, fetch, remote-url, head-revision, head-commit-sha, default-branch, current-branch, base, dirty, diff-range, diff-names, diff-stat, new-files, log-range, log-head, branch, commit, push, fix-commit" >&2
    exit 1
    ;;
esac
